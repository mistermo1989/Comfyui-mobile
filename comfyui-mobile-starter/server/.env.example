PORT=5000
NODE_ENV=development
APP_API_SECRET=replace-with-a-long-random-secret

# RunPod REST API v2
RUNPOD_API_KEY=
RUNPOD_API_BASE=https://api.runpod.io/v2

# Ephemeral Pod settings — no Network Volume
RUNPOD_POD_TEMPLATE_ID=
RUNPOD_POD_NAME=ComfyUI-Mobile
RUNPOD_CONTAINER_DISK_GB=100
RUNPOD_VOLUME_GB=0

# Optional browser frontend origin; native Android WebView file origin is allowed separately
APP_ORIGIN=https://your-frontend.example.com
